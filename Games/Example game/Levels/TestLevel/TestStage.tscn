[node name="Label3D" parent="TestStageTutorial1_Welcome" index="0" unique_id=284775712]
text = "Welcome to Badnik Framework test level!
It was created mostly for testing, but it's also
a showcase of its features.

Get closer to display controls. It will
autodetect your input scheme and joypad
type (if applicable)"

