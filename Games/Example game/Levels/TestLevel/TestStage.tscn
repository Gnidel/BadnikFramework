[node name="Label3D" parent="TestStageTutorial13_Water" index="0" unique_id=284775712]
text = "You can run on water if you run into
it fast enough and with proper angle.
Or you can just drown."

[node name="TestStageTutorial14_Switch2DLayers" parent="." unique_id=1051972616 instance=ExtResource("59_nd2cx")]
