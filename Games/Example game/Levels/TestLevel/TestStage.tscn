[node name="Label3D" parent="TestStageTutorial14_Switch2DLayers" index="0" unique_id=284775712]
text = "You can change 2D layers by
placing a 2D section trigger.

Grind rails and homing attacks ignore 2D.
It's not a bug, it's a design decision
to make background bosses easier to make."

[node name="TestStageTutorial15_Curved2D" parent="." unique_id=427606544 instance=ExtResource("59_nd2cx")]
